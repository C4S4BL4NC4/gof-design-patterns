# ============================================
# Visual Studio / .NET .gitignore
# ============================================

# -------------------------
# Visual Studio
# -------------------------

.vs/
.vscode/

# User-specific Visual Studio files
*.user
*.userosscache
*.suo
*.userprefs

# Visual Studio workspace files
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# CodeRush
.cr/

# Rider
.idea/

# -------------------------
# Build output
# -------------------------

[Bb]in/
[Oo]bj/

# Debug / Release output
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Generated build files
*.dll
*.exe
*.pdb
*.obj
*.ilk
*.idb
*.lib
*.exp

# -------------------------
# .NET generated files
# -------------------------

*.nupkg
*.snupkg

# NuGet packages
packages/

# NuGet generated files
project.lock.json
project.fragment.lock.json
artifacts/

# Generated documentation
*.xml

# -------------------------
# ASP.NET / Web
# -------------------------

# ASP.NET generated files
wwwroot/lib/

# Node modules (if using npm)
node_modules/

# Frontend build output
dist/
build/

# -------------------------
# Test output
# -------------------------

TestResults/
[Tt]est[Rr]esult*/
*.trx

# Code coverage
coverage/
.coverage
.coveragexml
*.coverage

# -------------------------
# Logs
# -------------------------

*.log
logs/

# -------------------------
# Temporary files
# -------------------------

*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# -------------------------
# OS-specific files
# -------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# -------------------------
# Visual Studio generated
# -------------------------

*.pidb
*.svclog
*.scc

# -------------------------
# Database local files
# -------------------------

*.mdf
*.ldf
*.ndf

# SQLite databases
*.db
*.sqlite
*.sqlite3

# -------------------------
# Azure / Cloud tooling
# -------------------------

.publishsettings

# -------------------------
# Docker
# -------------------------

# Docker volumes / local data
.docker/

# -------------------------
# Secrets / local configuration
# -------------------------

# User-specific local settings
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# Environment variables
.env
.env.*
!.env.example

# -------------------------
# Certificates / keys
# -------------------------

*.pfx
*.p12

# -------------------------
# Generated source
# -------------------------

Generated/
generated/

# -------------------------
# EF Core generated migrations
# -------------------------
# NOTE:
# Usually DO NOT ignore Migrations/.
# EF Core migrations should normally be committed.
#
# If you specifically generate migrations locally
# and don't want them tracked, uncomment:
#
# Migrations/

# -------------------------
# Entity Framework / tooling
# -------------------------

*.edmx.diagram

# -------------------------
# Publish output
# -------------------------

publish/
Publish/

# -------------------------
# Local launch settings
# -------------------------

# Usually launchSettings.json SHOULD be committed,
# so this is intentionally NOT ignored.
#
# If yours contains secrets, remove them before committing.

# -------------------------
# MSBuild generated files
# -------------------------

*.csproj.user
*.proj.user
*.sln.docstates

# -------------------------
# BenchmarkDotNet
# -------------------------

BenchmarkDotNet.Artifacts/

# -------------------------
# Sonar
# -------------------------

.sonar/

# -------------------------
# JetBrains / Rider
# -------------------------

.idea/
*.sln.iml

# -------------------------
# Miscellaneous generated files
# -------------------------

*.cache
*.ncb
*.opensdf
*.sdf
*.suo
*.user
*.userosscache
